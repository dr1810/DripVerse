# Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key-here

# Model roles (defaults verified against ai.google.dev/gemini-api/docs/models)
# Model A: multimodal interpretation -> structured attributes + Shopify search query
GEMINI_INTERPRET_MODEL=gemini-4-hydrogen
# Model B: visual consistency evaluation (reference vs generated)
GEMINI_EVALUATE_MODEL=gemini-4-neon
# Nano Banana 2: scene generation
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TIMEOUT_MS=90000

# Shopify Global Catalog: search needs no key. Optional token raises rate limits.
# SHOPIFY_AGENT_PROFILE_URL=https://your-app.example/profiles/agent.json
# SHOPIFY_CATALOG_TOKEN=
